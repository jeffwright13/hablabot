{
  "name": "hablabot",
  "version": "0.5.0",
  "description": "AI-powered Spanish conversation practice with voice interaction",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve": "npx serve .",
    "test:browser": "playwright test --project=app",
    "test:live": "HABLABOT_LIVE=1 playwright test --project=live"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.0",
    "vitest": "^2.0.0"
  }
}
